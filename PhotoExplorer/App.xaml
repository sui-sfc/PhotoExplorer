<Application x:Class="PhotoExplorer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PhotoExplorer.Presentation.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <conv:StatusToBrushConverter        x:Key="StatusToBrush"/>
        <conv:StatusToTextConverter         x:Key="StatusToText"/>
        <conv:LogLevelToBrushConverter      x:Key="LogLevelToBrush"/>
        <conv:OperationModeDisplayConverter x:Key="ModeDisplay"/>
        <conv:BoolToVisibilityConverter     x:Key="BoolToVis"/>
        <conv:FileSizeConverter             x:Key="FileSize"/>

        <SolidColorBrush x:Key="AccentBrush"   Color="#2563EB"/>
        <SolidColorBrush x:Key="PanelBrush"    Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BorderBrush"   Color="#CBD5E1"/>
        <SolidColorBrush x:Key="MutedBrush"    Color="#64748B"/>
        <SolidColorBrush x:Key="HeadingBrush"  Color="#1E293B"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Margin"     Value="0,14,0,6"/>
            <Setter Property="Foreground" Value="{StaticResource HeadingBrush}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource HeadingBrush}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,16,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin"  Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>
        <Style x:Key="BigButton" TargetType="Button">
            <Setter Property="Padding"  Value="16,8"/>
            <Setter Property="Margin"   Value="0,0,0,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
