<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Linux / macOS の CI でもビルド（コンパイル確認）できるようにする -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PhotoExplorer</AssemblyName>
    <RootNamespace>PhotoExplorer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>2.2.0</Version>
    <Product>PhotoExplorer</Product>
    <Description>EXIF をもとに写真を整理するツール</Description>
    <Authors>sui-sfc</Authors>
    <Company>sui-sfc</Company>
    <Copyright>Copyright (c) 2026 sui-sfc</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- dotnet publish -c Release で exe 1 つにまとめる -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoExplorer.Core\PhotoExplorer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ライセンス表記を exe と一緒に配布する -->
    <None Include="..\LICENSE;..\THIRD_PARTY_NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <Link>%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Resources フォルダに置いた exiftool（exiftool.exe と exiftool_files）を出力に含める -->
    <None Include="Resources\**\*" Exclude="Resources\.gitkeep">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

</Project>
